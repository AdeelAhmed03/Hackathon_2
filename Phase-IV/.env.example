# Environment Variables for Docker Compose Deployment
# Copy this file to .env and fill in your actual values

# Cohere AI API Key (get from https://dashboard.cohere.com/)
COHERE_API_KEY=your-cohere-api-key-here

# Better Auth Secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-better-auth-secret-here

# Database Configuration (default values for local development)
DATABASE_URL=postgresql://postgres:password@postgres:5432/todo
